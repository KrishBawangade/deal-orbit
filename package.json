{
  "name": "odoo-hack-starter",
  "version": "1.0.0",
  "description": "Fullstack Hackathon Starter with Next.js 16, Express Clean Architecture, Prisma & PostgreSQL",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down",
    "db:push": "npm run prisma:push --prefix backend",
    "db:studio": "npm run prisma:studio --prefix backend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "hackathon",
    "nextjs",
    "express",
    "clean-architecture",
    "prisma",
    "postgresql",
    "docker"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
