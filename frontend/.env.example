# Google Gemini API Key for Customer Negotiation & Counter-Quote Simulation
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Browser / Client Components API URL (requests made from user's browser)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Next.js Server Components / SSR API URL (requests made inside Docker container)
INTERNAL_API_URL=http://backend:5000
